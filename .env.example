# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: The port that the server listens on. Render assigns this dynamically.
# For local or custom hosting, defaults to 3000.
PORT=10000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Keep keys server-side only for secure synchronization
# Configure these in your AI Studio Secrets panel.
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# SUPABASE_SERVICE_ROLE_KEY: Backend database service role secret. Must NEVER be exposed to the frontend.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# CORS configuration
ALLOWED_ORIGINS="http://localhost:3000,https://ais-dev-bpswhanfafmz2n4uhirm2r-282616133432.asia-southeast1.run.app"

# SaaS Admin Security
# bcrypt hash of the SaaS Owner password/PIN
SAAS_OWNER_PASSWORD_HASH=
# Master verification code for emergency owner unlock override and registration bypass (Strictly requires env var; no hardcoded fallback)
MASTER_VERIFICATION_CODE=

# RESEND & SMTP CONFIGURATION
# Configure Resend or Free Gmail SMTP (Option 1) in your Secrets panel for sending zero-cost verification emails
RESEND_API_KEY=
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# MONITORING & ALERTING CONFIGURATION
# Configure these in your AI Studio Secrets panel to get immediate notifications on Slack or Sentry
SENTRY_DSN="https://your_sentry_key@o0.ingest.sentry.io/your_project_id"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/X00"
EMAIL_ALERT_ADDRESS="alerts@yourdomain.com"

# REDIS CACHING CONFIGURATION
# Configure these in your Secrets panel to enable production Redis caching
REDIS_URL=
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=

